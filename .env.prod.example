# 生产环境配置模板
# 用法：cp .env.prod.example .env   然后填写真实值
# 注意：JWT_SECRET_KEY / FERNET_KEY 必须稳定写死，切勿留空或每次随机，
#       否则重启后 JWT 令牌失效 / 已加密的域账号密码密文无法解密。

# 数据库密码（需与 backend DATABASE_URL 中的密码保持一致）
DB_PASSWORD=change-me-strong-password

# JWT 签名密钥：openssl rand -hex 32
JWT_SECRET_KEY=replace-with-openssl-rand-hex-32

# 域服务账号密码加密密钥（Fernet key）：
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=replace-with-fernet-key

# 前端访问地址（生产前端暴露端口，用于 CORS）
CORS_ORIGINS=http://your-server-ip:8080
