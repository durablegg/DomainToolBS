# ---- 应用 ----
APP_NAME=DomainToolBS
DEBUG=false
API_PREFIX=/api/v1
LOG_LEVEL=INFO

# ---- 本地库（开发用 SQLite；生产改 PostgreSQL，如 postgresql+psycopg://user:pass@db:5432/domaintool）----
DATABASE_URL=sqlite:///./domaintool.db

# ---- JWT（生产务必替换）----
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# ---- 域服务账号密码加密密钥（生产务必配置，否则重启后旧密文无法解密）----
FERNET_KEY=

# ---- 跨域（前端开发地址）----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
